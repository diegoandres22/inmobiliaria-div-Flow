# Supabase — se completan en FASE 4 al provisionar el proyecto
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

# Mapas — MapTiler (FASE 3)
NEXT_PUBLIC_MAPTILER_KEY=

# Rate limiting — Upstash Redis (FASE 4)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Email transaccional de leads — Resend (FASE 4)
RESEND_API_KEY=

# Anti-spam — Cloudflare Turnstile, opcional si el honeypot no basta (FASE 4)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Salt para hashear IPs en leads.ip_hash — cualquier string largo y secreto
IP_HASH_SALT=

