# Supabase — se completan en FASE 4 al provisionar el proyecto
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

# Mapas — Google Maps Embed API (ficha pública + selector de ubicación admin).
# Clave client-side (va en el <iframe src>), se restringe por HTTP referrer
# en Google Cloud Console, no por IP. Sin esta clave, el mapa muestra un
# fallback "no configurado" pero las coordenadas se guardan igual.
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_KEY=

# Rate limiting — Upstash Redis (FASE 4)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Email transaccional de leads — Resend (FASE 4)
RESEND_API_KEY=

# Anti-spam — Cloudflare Turnstile, opcional si el honeypot no basta (FASE 4)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Salt para hashear IPs en leads.ip_hash — cualquier string largo y secreto
IP_HASH_SALT=

# Google Analytics 4 — opcional. Si se completa, el script SOLO se carga
# cuando el visitante acepta la categoría "Analíticas" en el banner de
# cookies (ver src/components/cookies/analytics-scripts.tsx).
NEXT_PUBLIC_ANALYTICS_ID=

# Geocoding API de Google — opcional. Fallback server-side cuando el enlace
# de Google Maps pegado en "Nueva propiedad" no trae coordenadas embebidas
# (ver src/app/admin/(dashboard)/propiedades/maps-actions.ts). Sin esta
# clave, el parseo por regex + los campos manuales de lat/lng siguen
# funcionando igual — esto es solo para resolver el resto de los casos.
GOOGLE_MAPS_GEOCODING_API_KEY=

