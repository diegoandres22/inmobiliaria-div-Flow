# Supabase — se completan en FASE 4 al provisionar el proyecto
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

# Rate limiting — Upstash Redis (FASE 4)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Email transaccional — Resend. Usado hoy para confirmar cambios de
# contraseña (reset y manual, ver src/lib/email/) y a futuro para leads.
# Sin esta clave, esos emails simplemente no se mandan (se loguea un aviso)
# — el cambio de contraseña en sí no depende de que el email salga.
RESEND_API_KEY=
# Remitente verificado en Resend, formato "Nombre <email@tudominio.com>".
# Sin dominio propio verificado, se puede probar con el sandbox de Resend
# (onboarding@resend.dev) — no apto para producción real.
RESEND_FROM_EMAIL=

# Anti-spam — Cloudflare Turnstile, opcional si el honeypot no basta (FASE 4)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Salt para hashear IPs en leads.ip_hash — cualquier string largo y secreto
IP_HASH_SALT=

# Google Analytics 4 — opcional. Si se completa, el script SOLO se carga
# cuando el visitante acepta la categoría "Analíticas" en el banner de
# cookies (ver src/components/cookies/analytics-scripts.tsx).
NEXT_PUBLIC_ANALYTICS_ID=

